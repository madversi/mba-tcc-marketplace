{
  "uid": "resiliencia",
  "title": "Resiliencia",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "tags": ["marketplace"],
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Circuit breaker - estado",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "fechado", "color": "green" },
                "1": { "text": "meio-aberto", "color": "yellow" },
                "2": { "text": "aberto", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (breaker) (circuit_breaker_state)",
          "legendFormat": "{{breaker}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Circuit breaker - transicoes por minuto",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (breaker, to) (increase(circuit_breaker_transitions_total[1m]))",
          "legendFormat": "{{breaker}} -> {{to}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tempo de reprocessamento de falhas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, outcome) (rate(failure_reprocessing_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{outcome}}"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(failure_reprocessing_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fallback - ativacoes por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, source) (rate(fallback_activations_total[1m]))",
          "legendFormat": "{{job}} {{source}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Mensageria - retries por fila",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (rate(message_retry_total[1m]))",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mensageria - mensagens na fila dead (acumulado)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (message_dead_total)",
          "legendFormat": "{{queue}}"
        }
      ]
    }
  ]
}
